{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "resolveJsonModule": true, "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "esModuleInterop": true, "isolatedModules": true, "noEmit": true,
    "jsx": "react-jsx", "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}

{
  "name": "davy-lab-standard-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DAVYLAB reusable local-first application starter",
  "engines": { "node": ">=22.18.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": { "react": "^19.3.0", "react-dom": "^19.3.0" },
  "devDependencies": {
    "@types/node": "^24.10.1", "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2", "fake-indexeddb": "^6.2.5", "jsdom": "^30.1.2",
    "typescript": "~5.9.3", "vite": "^8.3.4", "vitest": "^5.0.4"
  }
}

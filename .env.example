TARGET_URL=https://example.test
TRUSTLOOP_OUT=reports/latest
TRUSTLOOP_ALLOWED_HOSTS=example.test
TRUSTLOOP_ENVIRONMENT=staging
TRUSTLOOP_ADAPTER=generic
# For the NianBox adapter only, use an isolated test/staging deployment:
# TRUSTLOOP_ADAPTER=niantou-box
# TRUSTLOOP_TEST_ACCOUNT_LABEL=trustloop-disposable-user-a
# Screenshots may contain page content; enable only for synthetic test data.
# TRUSTLOOP_CAPTURE_SCREENSHOTS=true

# Optional NianBox integration tests. Leave disabled for ordinary local runs.
# Stateful tests mutate ONLY synthetic records in a dedicated staging Worker/database.
# TRUSTLOOP_NIANBOX_STATEFUL_TESTS=false
# TRUSTLOOP_NIANBOX_STAGING_CONFIRMATION=I_CONFIRM_STAGING_ONLY
# TRUSTLOOP_NIANBOX_CLOUD_URL=https://your-nianbox-cloud-staging.example.test
# TRUSTLOOP_NIANBOX_TEST_EMAIL=trustloop-test@example.test
# TRUSTLOOP_NIANBOX_TEST_PASSWORD=use-a-disposable-test-account-password

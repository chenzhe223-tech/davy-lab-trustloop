{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustLoop Report v1",
  "type": "object",
  "required": ["schemaVersion", "runId", "target", "startedAt", "finishedAt", "status", "summary", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string" },
    "target": { "type": "object", "required": ["url", "environment"], "properties": {
      "url": { "type": "string", "format": "uri" },
      "environment": { "enum": ["local", "test", "staging", "production", "unknown"] }
    }},
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "ERROR"] },
    "summary": { "type": "object", "required": ["total", "passed", "failed", "blocked", "skipped"], "properties": {
      "total": { "type": "integer", "minimum": 0 },
      "passed": { "type": "integer", "minimum": 0 },
      "failed": { "type": "integer", "minimum": 0 },
      "blocked": { "type": "integer", "minimum": 0 },
      "skipped": { "type": "integer", "minimum": 0 }
    }},
    "checks": { "type": "array", "items": { "type": "object", "required": ["id", "category", "severity", "status", "title", "details", "critical"], "properties": {
      "id": { "type": "string" },
      "category": { "enum": ["availability", "runtime", "functional", "accessibility", "performance", "security", "privacy"] },
      "severity": { "enum": ["low", "medium", "high", "critical"] },
      "status": { "enum": ["PASS", "FAIL", "BLOCKED", "SKIP", "ERROR"] },
      "title": { "type": "string" },
      "details": { "type": "string" },
      "critical": { "type": "boolean" },
      "repairHint": { "type": "string" }
    }}}
  }
}
